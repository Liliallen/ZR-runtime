+                return true;
+            }
+
+            BufferDescriptor[] current = buffers.Bindings;
+
+            for (int i = 0; i < count; i++)
+            {
+                if (current[i].Binding != descriptors[i].Binding || current[i].Slot != descriptors[i].Slot)
+                {
+                    return false;
+                }
+            }
+
+            return true;
         }
 
