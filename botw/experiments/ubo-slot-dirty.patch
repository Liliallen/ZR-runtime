+        /// <summary>
+        /// BOTW-PC: binds the graphics uniform buffers of the slots marked in <see cref="_gpUniformDirtySlots"/> and
+        /// synchronizes the others (see the comment at <see cref="_uboSlotDirty"/>).
+        /// </summary>
+        private void BindDirtyUniformSlots(BufferCache bufferCache)
+        {
+            int rangesCount = 0;
+
+            Span<BufferAssignment> ranges = _ranges;
+
+            for (ShaderStage stage = ShaderStage.Vertex; stage <= ShaderStage.Fragment; stage++)
+            {
+                ref BuffersPerStage buffers = ref _gpUniformBuffers[(int)stage - 1];
+                ref uint dirtySlots = ref _gpUniformDirtySlots[(int)stage - 1];
+                BufferStage bufferStage = BufferStageUtils.FromShaderStage(stage);
+
+                for (int index = 0; index < buffers.Count; index++)
+                {
+                    ref BufferDescriptor bindingInfo = ref buffers.Bindings[index];
+
+                    BufferBounds bounds = buffers.Buffers[bindingInfo.Slot];
+
+                    if ((dirtySlots & (1u << bindingInfo.Slot)) != 0)
+                    {
+                        // Like the full rebind, an unmapped slot is not sent.
+                        if (!bounds.IsUnmapped)
+                        {
+                            ranges[rangesCount++] = new BufferAssignment(bindingInfo.Binding, bufferCache.GetBufferRange(bounds.Range, bufferStage));
+                        }
+                    }
+                    else if (!bounds.IsUnmapped)
+                    {
+                        bufferCache.SynchronizeBufferRange(bounds.Range);
+                    }
+                }
+
+                dirtySlots = 0;
+            }
