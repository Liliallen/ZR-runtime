+        /// <summary>
+        /// BOTW-PC optimized GPU front end (set by the GPU at start, 0 = off): how long the render thread polls for new
+        /// commands after draining the queue before it blocks on <see cref="_galWorkAvailable"/>. A producer that
+        /// queues a command into an empty queue sets the event; while the render thread is blocked that is a kernel
+        /// call on the GPU command thread (the critical path in BotW), while it is still polling the set is a plain
+        /// memory operation. Only the waiting changes: the commands, their order and the wake-up event are the same.
+        /// </summary>
+        public static long RenderSpinTicks;
+
+        private static readonly Ryujinx.Common.BotwPc.AbPhase.Switch _renderSpin = new("BOTWPC_FE_GAL_SPIN");
+
+        [MethodImpl(MethodImplOptions.NoInlining)]
+        private void SpinForWork()
+        {
+            long until = System.Diagnostics.Stopwatch.GetTimestamp() + RenderSpinTicks;
+
+            while (Volatile.Read(ref _commandCount) == 0 &&
+                Volatile.Read(ref _interruptAction) == null &&
+                System.Diagnostics.Stopwatch.GetTimestamp() < until)
+            {
+                Thread.SpinWait(16);
+            }
+        }
+
