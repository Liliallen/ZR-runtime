+        /// <summary>
+        /// BOTW-PC optimized front end: requests the first 4 KiB of a command buffer into the cache before decoding it.
+        /// BotW sends ~4 700 command buffers per frame, ~54 words each, written by the game's CPU threads just before:
+        /// decoding one word at a time waits for each cache line in turn (a third of the decode loop's samples sat on
+        /// the load of the command word), and the buffers are too short for the hardware prefetcher to get ahead.
+        /// A prefetch is only a hint: it changes no data and no order. x86 only (no-op elsewhere).
+        /// </summary>
+        [MethodImpl(MethodImplOptions.AggressiveInlining)]
+        private static unsafe void PrefetchCommands(ReadOnlySpan<int> commandBuffer)
+        {
+            if (!System.Runtime.Intrinsics.X86.Sse.IsSupported)
+            {
+                return;
+            }
+
+            int bytes = Math.Min(commandBuffer.Length * sizeof(int), 4096);
+
+            fixed (int* words = commandBuffer)
+            {
+                byte* data = (byte*)words;
+
+                for (int offset = 0; offset < bytes; offset += 64)
+                {
+                    System.Runtime.Intrinsics.X86.Sse.Prefetch0(data + offset);
+                }
+            }
+        }
+
