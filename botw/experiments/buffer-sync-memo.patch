diff --git a/src/Ryujinx.Graphics.Gpu/Memory/BufferCache.cs b/src/Ryujinx.Graphics.Gpu/Memory/BufferCache.cs
index d1d0a4ef3..32ec766bf 100644
--- a/src/Ryujinx.Graphics.Gpu/Memory/BufferCache.cs
+++ b/src/Ryujinx.Graphics.Gpu/Memory/BufferCache.cs
@@ -67,6 +67,171 @@ namespace Ryujinx.Graphics.Gpu.Memory
         /// </summary>
         public int ModificationSequence => Volatile.Read(ref _modificationSequence);
 
+        /// <summary>
+        /// BOTW-PC optimized front end: the last guest-to-host synchronization of one bound range (a vertex, index or
+        /// uniform buffer slot). Every draw synchronizes every bound buffer range. A synchronization in the same GPU
+        /// sequence number as the previous one of the same range is a no-op in the legacy path: the granular tracking
+        /// skips handles already checked in the sequence (MultiRegionHandle's sequence bitmap), the whole-buffer
+        /// tracking compares the sequence it recorded at its last load (<see cref="Buffer.SyncGatedBySequence"/>;
+        /// a clean whole-buffer check records nothing, so it is not skipped), and the only other work (a forced dirty range, forced tracking dirt,
+        /// virtual dependants) is covered by <see cref="Buffer.SyncVersion"/> and
+        /// <see cref="Buffer.HasVirtualDependencies"/>. The buffer still contains the range while
+        /// <see cref="ModificationSequence"/> is unchanged. So while all of those are unchanged, the lookup and the
+        /// synchronization are skipped, and the range of the remembered buffer is the one GetBufferRange returns.
+        /// </summary>
+        internal struct SyncMemo
+        {
+            public BufferCache Cache;
+            public Buffer Buffer;
+            public ulong Address;
+            public ulong Size;
+            public int ContextSequence;
+            public int CacheSequence;
+            public int BufferVersion;
+        }
+
+        [MethodImpl(MethodImplOptions.AggressiveInlining)]
+        private bool IsCurrent(in SyncMemo memo, ulong address, ulong size)
+        {
+            Buffer buffer = memo.Buffer;
+
+            return buffer != null &&
+                ReferenceEquals(memo.Cache, this) &&
+                memo.Address == address &&
+                memo.Size == size &&
+                memo.ContextSequence == _context.SequenceNumber &&
+                memo.CacheSequence == _modificationSequence &&
+                memo.BufferVersion == buffer.SyncVersion &&
+                !buffer.HasVirtualDependencies &&
+                buffer.SyncGatedBySequence(memo.ContextSequence);
+        }
+
+        [MethodImpl(MethodImplOptions.AggressiveInlining)]
+        private static void CountMemo(bool hit)
+        {
+            if (Engine.FrontendStats.Enabled)
+            {
+                Engine.FrontendStats.E(hit ? Engine.FrontendStats.Ev.SyncMemoHits : Engine.FrontendStats.Ev.SyncMemoMisses);
+            }
+        }
+
+        /// <summary>
+        /// Looks up and synchronizes a single range, recording the memo (sequences read before the work, so a change
+        /// while it runs invalidates the memo).
+        /// </summary>
+        private Buffer SynchronizeAndRemember(ulong address, ulong size, ref SyncMemo memo)
+        {
+            CountMemo(false);
+            int contextSequence = _context.SequenceNumber;
+            int cacheSequence = _modificationSequence;
+
+            Buffer buffer = FindOverlapCached(address, size);
+            int version = buffer.SyncVersion;
+
+            buffer.CopyFromDependantVirtualBuffers();
+            buffer.SynchronizeMemory(address, size);
+
+            memo = new SyncMemo
+            {
+                Cache = this,
+                Buffer = buffer,
+                Address = address,
+                Size = size,
+                ContextSequence = contextSequence,
+                CacheSequence = cacheSequence,
+                BufferVersion = version,
+            };
+
+            return buffer;
+        }
+
+        /// <summary>
+        /// <see cref="SynchronizeBufferRange(MultiRange)"/> with a per-binding memo (<see cref="SyncMemo"/>).
+        /// </summary>
+        public void SynchronizeBufferRange(MultiRange range, ref SyncMemo memo)
+        {
+            if (!Engine.GpuFrontend.SyncMemo || range.Count != 1)
+            {
+                SynchronizeBufferRange(range);
+                return;
+            }
+
+            MemoryRange subRange = range.GetSubRange(0);
+
+            if (subRange.Size == 0)
+            {
+                return;
+            }
+
+            if (IsCurrent(memo, subRange.Address, subRange.Size))
+            {
+                CountMemo(true);
+
+                if (Engine.FrontendVerify.Enabled)
+                {
+                    VerifySkippedSync(memo, subRange.Address, subRange.Size, null);
+                }
+
+                return;
+            }
+
+            SynchronizeAndRemember(subRange.Address, subRange.Size, ref memo);
+        }
+
+        /// <summary>
+        /// <see cref="GetBufferRange(MultiRange, BufferStage, bool)"/> for a read-only binding, with a per-binding memo
+        /// (<see cref="SyncMemo"/>).
+        /// </summary>
+        public BufferRange GetBufferRange(MultiRange range, BufferStage stage, ref SyncMemo memo)
+        {
+            if (!Engine.GpuFrontend.SyncMemo || range.Count != 1 || range.GetSubRange(0).Size == 0)
+            {
+                return GetBufferRange(range, stage);
+            }
+
+            MemoryRange subRange = range.GetSubRange(0);
+
+            if (IsCurrent(memo, subRange.Address, subRange.Size))
+            {
+                CountMemo(true);
+                BufferRange cached = memo.Buffer.GetRange(subRange.Address, subRange.Size, false);
+
+                if (Engine.FrontendVerify.Enabled)
+                {
+                    VerifySkippedSync(memo, subRange.Address, subRange.Size, cached);
+                }
+
+                return cached;
+            }
+
+            return SynchronizeAndRemember(subRange.Address, subRange.Size, ref memo).GetRange(subRange.Address, subRange.Size, false);
+        }
+
+        /// <summary>
+        /// Differential verification of a skipped synchronization: runs the legacy lookup and synchronization (whose
+        /// effects then apply, as in the legacy path) and checks that it found the remembered buffer, returned the same
+        /// range and did no work.
+        /// </summary>
+        private void VerifySkippedSync(in SyncMemo memo, ulong address, ulong size, BufferRange? cached)
+        {
+            Buffer buffer = FindOverlapCached(address, size);
+            long workBefore = buffer.SyncWork;
+
+            buffer.CopyFromDependantVirtualBuffers();
+            buffer.SynchronizeMemory(address, size);
+
+            long work = buffer.SyncWork - workBefore;
+            BufferRange legacy = buffer.GetRange(address, size, false);
+            Buffer memoBuffer = memo.Buffer;
+            bool match = ReferenceEquals(buffer, memoBuffer) && work == 0 &&
+                (cached == null || (cached.Value.Handle == legacy.Handle && cached.Value.Offset == legacy.Offset && cached.Value.Size == legacy.Size));
+
+            Engine.FrontendVerify.Compare(Engine.FrontendVerify.Check.SyncMemo, match, () =>
+                $"range 0x{address:x}+0x{size:x}: legacy buffer 0x{buffer.Address:x}+0x{buffer.Size:x} (same object: {ReferenceEquals(buffer, memoBuffer)}), " +
+                $"legacy synchronization work {work}, cached range {(cached == null ? "-" : $"{cached.Value.Handle}+{cached.Value.Offset}+{cached.Value.Size}")}, " +
+                $"legacy range {legacy.Handle}+{legacy.Offset}+{legacy.Size}, sequence {_context.SequenceNumber}");
+        }
+
         private readonly Dictionary<ulong, BufferCacheEntry> _dirtyCache;
         private readonly Dictionary<ulong, BufferCacheEntry> _modifiedCache;
         private bool _pruneCaches;
