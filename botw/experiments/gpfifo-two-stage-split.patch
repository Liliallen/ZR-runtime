+using Ryujinx.Common.Logging;
+using Ryujinx.Graphics.Gpu.Engine.MME;
+using System;
+using System.Runtime.CompilerServices;
+using System.Threading;
+
+namespace Ryujinx.Graphics.Gpu.Engine.GPFifo
+{
+    /// <summary>
+    /// BOTW-PC: two-stage GPU command processing (BOTWPC_GPFIFO_SPLIT=1, off by default).
+    /// </summary>
+    /// <remarks>
+    /// Stage A (thread "GPU.Decode") fetches GPFIFO entries, decodes the command words and runs the guest's MME macros
+    /// against its own copy of the 3D register file; stage B (the existing GPU command thread) applies every register
+    /// write with its callbacks, runs HLE macros (the draws), state updates, bindings, semaphores and syncpoints, in the
+    /// original order. Stage A hands work over through a ring of compact packets, published per GPFIFO entry, never
+    /// per command buffer handshake (the reason a per-buffer decode stage measured slower, PERFORMANCE.md).
+    ///
+    /// Correctness rules:
+    /// - Entries with Entry1Sync.Wait ("wait for prior work before fetching") drain stage B before they are fetched,
+    ///   which is the hardware's GPFIFO semantics; other entries are fetched ahead, as the hardware prefetches them.
+    /// - Guest macros read only stage A's register copy. It receives every 3D register write stage A produces and
+    ///   mirrors the register effects of stage-B callbacks that macros could observe (SetFalcon04 scratch, uniform
+    ///   buffer offset, render-enable read as 0). BOTWPC_SPLIT_PROBE measured BotW 1.6.0: 688 818 macro register reads,
+    ///   none stale in gameplay; the only stale register (Falcon04 scratch, at boot) is mirrored here.
+    /// - A 2D-engine guest macro (no stage-A copy of that state) drains stage B and runs inline.
+    /// - The mode can change only at an entry boundary with no macro call open; on the way in, stage A's copy is
+    ///   re-synchronized from the real register file while stage B is idle. This allows in-run A/B
+    ///   (BOTWPC_AB_SWITCHES=BOTWPC_GPFIFO_SPLIT).
+    /// </remarks>
+    sealed class GPFifoSplit : IDisposable
+    {
+        public static readonly bool Enabled = Environment.GetEnvironmentVariable("BOTWPC_GPFIFO_SPLIT") == "1";
+        private static readonly Ryujinx.Common.BotwPc.AbPhase.Switch _switch = new("BOTWPC_GPFIFO_SPLIT");
+
+        // Packet types (low 4 bits of the header word).
+        public const int PMethod = 0;        // header | subchannel << 4 | method << 8, value
+        public const int PWrite3d = 1;       // header | offset << 8, value (guest macro output)
+        public const int PInline = 2;        // header | subchannel << 4, count, words
+        public const int PCbUpdate = 3;      // header, count, words
+        public const int PHle = 4;           // header | subchannel << 4 | function << 8, arg0, count, count x (word, va lo, va hi)
+        public const int PDeferredDraws = 5; // header
+        public const int PEndBuffer = 6;     // header (end of a command buffer: flush pending uniform data)
+        public const int PProcessor = 7;     // header | forceAllDirty << 4 | index << 8
+        private const int PWrap = 8;
+
+        private const int RingBits = 22;
+        private const int RingSize = 1 << RingBits;
+        private const long RingMask = RingSize - 1;
+        private const int PublishThreshold = 4096;
+
+        private readonly GPFifoDevice _device;
+        private readonly int[] _ring = new int[RingSize];
+        private readonly GPFifoProcessor[] _processors = new GPFifoProcessor[64];
+        private int _processorCount;
+
+        // Producer (stage A) position and the published copy of it; consumer (stage B) position and its published copy.
+        private long _write;
+        private long _published;
+        private long _read;
+        private long _consumed;
+
+        private int _consumerWaiting;
+        private volatile bool _decodeBusy;
+        private volatile bool _active;
+        private volatile bool _wantActive;
+        private volatile bool _queueReleased;
+        private volatile bool _disposed;
+
+        private readonly AutoResetEvent _decodeEvent = new(false);
+        private readonly Thread _thread;
+
+        private GPFifoProcessor _decodeProcessor;
+        private int _epoch;
+        private GPFifoProcessor _executeProcessor;
+
+        public long Drains;
+        public long InlineMacros;
+        public long SyncWaitsWithoutFlush;
+
+        // Diagnostics (Stopwatch ticks): stage B executing packets / spinning for stage A; stage A decoding / draining.
+        private long _bExecTicks, _bWaitTicks, _aDecodeTicks, _aDrainTicks, _lastReportTicks;
+        private long _entries;
+        private long _nextReport;
+
+        public GPFifoSplit(GPFifoDevice device)
+        {
+            _device = device;
+            _thread = new Thread(DecodeLoop) { Name = "GPU.Decode", IsBackground = true };
+            _thread.Start();
+
+            Logger.Info?.Print(LogClass.Gpu, "BOTW-PC: two-stage GPU command processing enabled (BOTWPC_GPFIFO_SPLIT=1)");
+        }
+
+        /// <summary>True while stage A owns the GPFIFO entry queue.</summary>
+        public bool Active => _active;
+
+        /// <summary>
+        /// Stage B: waits (spinning, up to about half a millisecond) for packets while stage A is decoding, instead of
+        /// leaving the dispatch loop and sleeping: after each sync drain stage B has nothing to do until stage A
+        /// decoded the next entry, and a sleep/wake there would add its latency to the critical thread every time.
+        /// </summary>
+        public bool WaitForPacketsWhileDecoding()
+        {
+            long start = System.Diagnostics.Stopwatch.GetTimestamp();
+            long deadline = start + System.Diagnostics.Stopwatch.Frequency / 2000;
+
+            while (_decodeBusy && !HasPackets)
+            {
+                if (System.Diagnostics.Stopwatch.GetTimestamp() > deadline)
+                {
+                    break;
+                }
+
+                Thread.SpinWait(20);
+            }
+
+            Interlocked.Add(ref _bWaitTicks, System.Diagnostics.Stopwatch.GetTimestamp() - start);
+
+            return HasPackets;
+        }
+
+        /// <summary>True when stage B has packets to execute.</summary>
+        public bool HasPackets => Volatile.Read(ref _published) != _read;
+
+        public void SignalNewEntries() => _decodeEvent.Set();
+
+        // ---- Stage A ----
+
+        private void DecodeLoop()
+        {
+            while (!_disposed)
+            {
+                bool wantOn = _switch.IsOn;
+
+                if (wantOn != _active)
+                {
+                    if (!SwitchMode(wantOn))
+                    {
+                        _decodeEvent.WaitOne(1);
+                        continue;
+                    }
+                }
+
+                if (!_active)
+                {
+                    _decodeEvent.WaitOne(8);
+                    continue;
+                }
+
+                if (!_device.TryDequeueForSplit(out GPFifoProcessor processor, out ulong address, out ReadOnlySpan<int> words, this))
+                {
+                    Publish();
+                    _decodeBusy = false;
+                    _decodeEvent.WaitOne(8);
+                    continue;
+                }
+
+                _decodeBusy = true;
+
+                if (processor.SplitEpoch != _epoch)
+                {
+                    // A channel not seen since the split became active: copy its registers once stage B is idle.
+                    Drain();
+                    processor.SyncDecodeState();
+                    processor.SplitEpoch = _epoch;
+                }
+
+                if (processor != _decodeProcessor)
+                {
+                    int index = Array.IndexOf(_processors, processor, 0, _processorCount);
+
+                    if (index < 0)
+                    {
+                        index = _processorCount;
+                        _processors[_processorCount++] = processor;
+                    }
+
+                    // Same as DispatchCalls: changing the channel forces all host state to be updated.
+                    PutHeader(PProcessor | (1 << 4) | (index << 8));
+                    _decodeProcessor = processor;
+                }
+
+                long decodeStart = System.Diagnostics.Stopwatch.GetTimestamp();
+                processor.DecodeForSplit(address, words, this);
+                Publish();
+                _entries++;
+
+                long now = System.Diagnostics.Stopwatch.GetTimestamp();
+                _aDecodeTicks += now - decodeStart;
+
+                if (now >= _nextReport)
+                {
+                    double ms(long t) => t * 1000.0 / System.Diagnostics.Stopwatch.Frequency;
+                    double span = ms(now - _lastReportTicks) / 1000.0;
+                    _lastReportTicks = now;
+                    _nextReport = now + System.Diagnostics.Stopwatch.Frequency * 10;
+                    Logger.Info?.Print(LogClass.Gpu, $"BOTW-PC GPFIFO split: {_entries} entries, {Drains} drains, {InlineMacros} inline 2D macros; " +
+                        $"per second: B execute {ms(Interlocked.Exchange(ref _bExecTicks, 0)) / span:F0} ms, B wait {ms(Interlocked.Exchange(ref _bWaitTicks, 0)) / span:F0} ms, " +
+                        $"A decode {ms(_aDecodeTicks) / span:F0} ms, A drain wait {ms(_aDrainTicks) / span:F0} ms");
+                    _aDecodeTicks = 0;
+                    _aDrainTicks = 0;
+                }
+            }
+        }
+
+        /// <summary>
+        /// Called by the GPFIFO device before fetching an entry that must see all previous work completed.
+        /// </summary>
+        public void BeforeSyncFetch(bool syncWait, bool flush)
+        {
+            Publish();
+
+            if (syncWait)
+            {
+                if (flush)
+                {
+                    Drain();
+                }
+                else
+                {
+                    SyncWaitsWithoutFlush++;
+                    Drain();
+                }
+            }
+        }
+
+        private bool SwitchMode(bool on)
+        {
+            if (!on)
+            {
+                // Stop taking entries; stage B executes what is in the ring, then takes the queue again.
+                if (_decodeProcessor != null && _decodeProcessor.HasOpenMacroCall)
+                {
+                    return false;
+                }
+
+                Publish();
+                Drain();
+                _decodeProcessor = null;
+                _queueReleased = false;
+                _active = false;
+                _device.SignalNewEntries();
+
+                return true;
+            }
+
+            // Ask stage B to stop taking entries at its next entry boundary, then take over with fresh state copies.
+            _wantActive = true;
+            _device.SignalNewEntries();
+
+            if (!_queueReleased)
+            {
+                return false;
+            }
+
+            _wantActive = false;
+            _epoch++;
+            _executeProcessor = null;
+            _decodeProcessor = null;
+            _active = true;
+
+            return true;
+        }
+
+        /// <summary>
+        /// Stage B: called between entries when it executes the queue itself; returns true if it must stop (stage A
+        /// takes over).
+        /// </summary>
+        public bool ReleaseQueueIfRequested()
+        {
+            if (_wantActive)
+            {
+                _queueReleased = true;
+                _decodeEvent.Set();
+
+                return true;
+            }
+
+            return false;
+        }
+
+        /// <summary>Stage B keeps not taking entries while a takeover is pending or active.</summary>
+        public bool QueueOwnedByDecode => _active || _queueReleased;
+
+        /// <summary>
+        /// Waits until stage B executed every published packet (stage A only).
+        /// </summary>
+        public void Drain()
+        {
+            Publish();
+            Drains++;
+
+            long start = System.Diagnostics.Stopwatch.GetTimestamp();
+            SpinWait wait = new();
+
+            while (Volatile.Read(ref _consumed) != _write)
+            {
+                wait.SpinOnce(sleep1Threshold: -1);
+            }
+
+            _aDrainTicks += System.Diagnostics.Stopwatch.GetTimestamp() - start;
+        }
+
+        [MethodImpl(MethodImplOptions.AggressiveInlining)]
+        private void EnsureSpace(int count)
+        {
+            long offset = _write & RingMask;
+
+            if (offset + count + 1 > RingSize)
+            {
+                WaitForFree((int)(RingSize - offset));
+                _ring[offset] = PWrap;
+                _write += RingSize - offset;
+            }
+
+            if (_write + count - Volatile.Read(ref _consumed) >= RingSize - 1)
+            {
+                WaitForFree(count);
+            }
+        }
+
+        private void WaitForFree(int count)
+        {
+            Publish();
+            SpinWait wait = new();
+
+            while (_write + count - Volatile.Read(ref _consumed) >= RingSize - 1)
+            {
+                wait.SpinOnce(sleep1Threshold: -1);
+            }
+        }
+
+        [MethodImpl(MethodImplOptions.AggressiveInlining)]
+        public void PutHeader(int header)
+        {
+            EnsureSpace(1);
+            _ring[_write & RingMask] = header;
+            _write++;
+        }
+
+        [MethodImpl(MethodImplOptions.AggressiveInlining)]
+        public void Put2(int header, int value)
+        {
+            EnsureSpace(2);
+            long offset = _write & RingMask;
+            _ring[offset] = header;
+            _ring[offset + 1] = value;
+            _write += 2;
+        }
+
+        public void PutSpan(int header, ReadOnlySpan<int> words)
+        {
+            EnsureSpace(words.Length + 2);
+            long offset = _write & RingMask;
+            _ring[offset] = header;
+            _ring[offset + 1] = words.Length;
+            words.CopyTo(_ring.AsSpan((int)offset + 2, words.Length));
+            _write += words.Length + 2;
+
+            if (_write - Volatile.Read(ref _published) >= PublishThreshold)
+            {
+                Publish();
+            }
+        }
+
+        public void PutHle(int subChannel, MacroHLEFunctionName function, int arg0, ReadOnlySpan<FifoWord> args)
+        {
+            EnsureSpace(4 + args.Length * 3);
+            long offset = _write & RingMask;
+            _ring[offset] = PHle | (subChannel << 4) | ((int)function << 8);
+            _ring[offset + 1] = arg0;
+            _ring[offset + 2] = args.Length;
+
+            for (int i = 0; i < args.Length; i++)
+            {
+                _ring[offset + 3 + i * 3] = args[i].Word;
+                _ring[offset + 4 + i * 3] = (int)args[i].GpuVa;
+                _ring[offset + 5 + i * 3] = (int)(args[i].GpuVa >> 32);
+            }
+
+            _write += 3 + args.Length * 3;
+
+            // Draws: let stage B start early.
+            Publish();
+        }
+
+        [MethodImpl(MethodImplOptions.AggressiveInlining)]
+        public void MaybePublish()
+        {
+            if (_write - _published >= PublishThreshold)
+            {
+                Publish();
+            }
+        }
+
+        public void Publish()
+        {
+            if (_write == _published)
+            {
+                return;
+            }
+
+            Interlocked.Exchange(ref _published, _write);
+
+            if (Volatile.Read(ref _consumerWaiting) != 0)
+            {
+                _device.SignalNewEntries();
+            }
+        }
+
+        // ---- Stage B ----
+
+        /// <summary>
+        /// Stage B is about to wait for work (full barrier, so stage A either sees the flag or stage B sees the packets).
+        /// </summary>
+        public void BeginConsumerWait() => Interlocked.Exchange(ref _consumerWaiting, 1);
+
+        public void EndConsumerWait() => Volatile.Write(ref _consumerWaiting, 0);
+
+        /// <summary>
+        /// Executes all published packets (stage B, GPU command thread).
+        /// </summary>
+        public void Execute(ref bool interrupt)
+        {
+            long execStart = System.Diagnostics.Stopwatch.GetTimestamp();
+            ExecuteImpl(ref interrupt);
+            Interlocked.Add(ref _bExecTicks, System.Diagnostics.Stopwatch.GetTimestamp() - execStart);
+        }
+
+        private void ExecuteImpl(ref bool interrupt)
+        {
+            long published = Volatile.Read(ref _published);
+            int executed = 0;
+
+            while (_read != published && !interrupt)
+            {
+                long offset = _read & RingMask;
+                int header = _ring[offset];
+                GPFifoProcessor processor = _executeProcessor;
+
+                switch (header & 0xf)
+                {
+                    case PMethod:
+                        processor.ExecuteMethod(header >> 8, _ring[offset + 1], (header >> 4) & 0xf);
+                        _read += 2;
+                        break;
+                    case PWrite3d:
+                        processor.ThreedClass.Write(header >> 8, _ring[offset + 1]);
+                        _read += 2;
+                        break;
+                    case PInline:
+                        {
+                            int count = _ring[offset + 1];
+                            processor.ExecuteInlineData((header >> 4) & 0xf, _ring.AsSpan((int)offset + 2, count));
+                            _read += 2 + count;
+                            break;
+                        }
+                    case PCbUpdate:
+                        {
+                            int count = _ring[offset + 1];
+                            processor.ThreedClass.ConstantBufferUpdate(_ring.AsSpan((int)offset + 2, count));
+                            _read += 2 + count;
+                            break;
+                        }
+                    case PHle:
+                        {
+                            int count = _ring[offset + 2];
+                            processor.ExecuteHle((MacroHLEFunctionName)(header >> 8), (header >> 4) & 0xf, _ring[offset + 1], _ring.AsSpan((int)offset + 3, count * 3));
+                            _read += 3 + count * 3;
+                            break;
+                        }
+                    case PDeferredDraws:
+                        processor.PerformDeferredDraws();
+                        _read++;
+                        break;
+                    case PEndBuffer:
+                        processor.ThreedClass.FlushUboDirty();
+                        _read++;
+                        break;
+                    case PProcessor:
+                        _executeProcessor = _processors[header >> 8];
+
+                        if (((header >> 4) & 1) != 0)
+                        {
+                            _executeProcessor.ForceAllDirty();
+                        }
+
+                        _read++;
+                        break;
+                    case PWrap:
+                        _read += RingSize - offset;
+                        break;
+                    default:
+                        throw new InvalidOperationException($"BOTW-PC GPFIFO split: bad packet 0x{header:x} at {_read}");
+                }
+
+                if (++executed == 512)
+                {
+                    executed = 0;
+                    Volatile.Write(ref _consumed, _read);
+
+                    if (_read == published)
+                    {
+                        published = Volatile.Read(ref _published);
+                    }
+                }
+                else if (_read == published)
+                {
+                    published = Volatile.Read(ref _published);
+                }
+            }
+
+            Volatile.Write(ref _consumed, _read);
+        }
+
+        public void Dispose()
+        {
+            _disposed = true;
+            _decodeEvent.Set();
+            _thread.Join(1000);
+            _decodeEvent.Dispose();
+        }
+    }
+}
