+        // BOTW-PC: batched page protection. Re-arming write tracking for a run of dirty pages changed the protection one
+        // 4 KiB page per OS call (VirtualProtect/mprotect). Between BeginProtectionBatch and EndProtectionBatch the
+        // calling thread holds TrackingLock, so no other thread can change any region's protection in between (every
+        // path that does takes the lock), and the protection changes of contiguous regions with the same permission are
+        // applied as one call when the batch ends or a non-contiguous change starts. Callers end the batch before they
+        // read the guest data the reprotected pages hold, so a write in the meantime is either in the data they read or
+        // faults afterwards, as without batching. Same idea as Eden's coalescing of tracked page ranges before
+        // changing their protection (#3288), re-implemented. BOTWPC_BATCH_REPROTECT=0 disables it.
+        public static readonly Ryujinx.Common.BotwPc.AbPhase.Switch BatchReprotect = new("BOTWPC_BATCH_REPROTECT");
+
+        private int _batchThread = -1;
+        private int _batchCount;
+        private ulong _batchAddress;
+        private ulong _batchSize;
+        private MemoryPermission _batchPermission;
+        private bool _batchGuest;
+
+        /// <summary>
+        /// Starts collecting protection changes of this thread (takes TrackingLock until <see cref="EndProtectionBatch"/>).
+        /// </summary>
+        internal void BeginProtectionBatch()
+        {
+            Monitor.Enter(TrackingLock);
+            _batchThread = Environment.CurrentManagedThreadId;
+        }
+
+        /// <summary>
+        /// Applies the collected protection changes and releases TrackingLock.
+        /// </summary>
+        internal void EndProtectionBatch()
+        {
+            try
+            {
+                FlushBatchedProtection();
+            }
+            finally
+            {
+                _batchThread = -1;
+                Monitor.Exit(TrackingLock);
+            }
+        }
+
+        private void FlushBatchedProtection()
+        {
+            if (_batchCount == 0)
+            {
+                return;
+            }
+
+            if (Ryujinx.Common.BotwPc.GpuCounters.Detailed)
+            {
+                long start = System.Diagnostics.Stopwatch.GetTimestamp();
+                _memoryManager.TrackingReprotect(_batchAddress, _batchSize, _batchPermission, _batchGuest);
+                Ryujinx.Common.BotwPc.GpuCounters.AddElapsed(Ryujinx.Common.BotwPc.GpuCounters.Id.Reprotects, Ryujinx.Common.BotwPc.GpuCounters.Id.ReprotectTicks, start);
+                Ryujinx.Common.BotwPc.GpuCounters.Add(Ryujinx.Common.BotwPc.GpuCounters.Id.ReprotectsBatched, _batchCount);
+            }
+            else
+            {
+                _memoryManager.TrackingReprotect(_batchAddress, _batchSize, _batchPermission, _batchGuest);
+            }
+
+            _batchCount = 0;
+        }
